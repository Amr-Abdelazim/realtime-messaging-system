{
  "name": "realtime-messaging-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @realtime-messaging/contracts build && pnpm -r --if-present typecheck && pnpm exec tsc --noEmit -p prisma/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:migrate": "pnpm prisma migrate dev",
    "db:deploy": "pnpm prisma migrate deploy",
    "db:seed": "pnpm prisma db seed",
    "db:reset": "pnpm prisma migrate reset --force",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@prisma/client": "6.19.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prisma": "6.19.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "argon2": "^0.45.2"
  }
}
