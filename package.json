{
    "name": "realtime-messaging-system",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@12.21.0",
    "type": "module",
    "scripts": {
        "dev": "pnpm --parallel --filter './apps/*' dev",
        "build": "pnpm -r --if-present build",
        "lint": "eslint .",
        "typecheck": "pnpm --filter @realtime-messaging/contracts build && pnpm -r --if-present typecheck",
        "test": "vitest run",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.0"
    }
}